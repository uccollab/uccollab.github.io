{% if site.teachings and site.teachings.size > 0 %}

  {% assign sorted_teachings = site.teachings | sort: "institution" %}
  {% assign institutions = sorted_teachings | group_by: "institution" %}

  <div class="teaching-universities">

    {% for institution_group in institutions %}

      <section class="teaching-university">

        <h2 class="teaching-university-title">
          {{ institution_group.name }}
        </h2>

        {% assign sorted_institution_courses = institution_group.items | sort: "course_name" %}
        {% assign course_groups = sorted_institution_courses | group_by: "course_key" %}

        <div class="teaching-course-list">

          {% for course_group in course_groups %}

            {% assign offerings = course_group.items | sort: "offering_sort" | reverse %}
            {% assign representative_course = offerings | first %}

            <details class="teaching-course">

              <summary class="teaching-course-summary">
                <span class="teaching-course-summary-text">
                  {{ representative_course.course_name | default: representative_course.title }}
                </span>
              </summary>

              <div class="teaching-course-body">

                {% if representative_course.description %}
                  <div class="teaching-course-description">
                    {{ representative_course.description | markdownify }}
                  </div>
                {% endif %}

                <div class="teaching-offerings">

                  {% for offering in offerings %}

                    <div class="teaching-offering-row">

                      <div class="teaching-offering-info">

                        <div class="teaching-offering-title">
                          {% if offering.offering %}
                            {{ offering.offering }}
                          {% elsif offering.term and offering.year %}
                            {{ offering.term }} {{ offering.year }}
                          {% elsif offering.term %}
                            {{ offering.term }}
                          {% elsif offering.year %}
                            {{ offering.year }}
                          {% else %}
                            Course offering
                          {% endif %}
                        </div>

                        {% if offering.time %}
                          <div class="teaching-offering-meta">
                            {{ offering.time }}
                          </div>
                        {% endif %}

                        {% if offering.instructor %}
                          <div class="teaching-offering-meta">
                            {{ offering.instructor }}
                          </div>
                        {% endif %}

                        <div class="teaching-offering-link">
                          <a href="{{ offering.url | relative_url }}">
                            Open full course page →
                          </a>
                        </div>

                      </div>

                    </div>

                  {% endfor %}

                </div>

              </div>

            </details>

          {% endfor %}

        </div>

      </section>

    {% endfor %}

  </div>

{% else %}

  <p>No courses available yet.</p>

{% endif %}