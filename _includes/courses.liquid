{% if site.teachings %}

  {% assign sorted_courses = site.teachings | sort: 'course_name' %}
  {% assign course_groups = sorted_courses | group_by_exp: 'course', 'course.course_key | default: course.title' %}

  <div class="teaching-courses">
    {% for course_group in course_groups %}

      {% assign offerings = course_group.items | sort: 'offering_sort' | reverse %}
      {% assign representative_course = offerings | first %}

      <section class="teaching-course">
        <h2 class="teaching-course-title">
          {{ representative_course.course_name | default: representative_course.title }}
        </h2>

        <div class="teaching-offerings">
          {% for offering in offerings %}

            <details class="teaching-offering" name="teaching-offerings">
              <summary class="teaching-offering-summary">

                <span class="teaching-offering-main">

                  {% if offering.institution %}
                    <span class="teaching-offering-institution">
                      {{ offering.institution }}
                    </span>
                  {% endif %}

                  {% if offering.institution and offering.offering %}
                    <span class="teaching-offering-separator">
                      ·
                    </span>
                  {% endif %}

                  {% if offering.offering %}
                    <span class="teaching-offering-semester">
                      {{ offering.offering }}
                    </span>
                  {% elsif offering.term %}
                    <span class="teaching-offering-semester">
                      {{ offering.term }}
                    </span>
                  {% endif %}

                </span>

              </summary>

              <div class="teaching-offering-body">

                <div class="teaching-offering-scroll">

                  {% assign offering_content = offering.content | strip %}

                  {% if offering_content != blank %}

                    {% if offering.description %}
                      <div class="teaching-offering-description">
                        {{ offering.description | markdownify }}
                      </div>
                    {% endif %}

                    {% if offering.instructor or offering.time %}
                      <div class="teaching-offering-meta">

                        {% if offering.instructor %}
                          <div>
                            <strong>Instructor:</strong>
                            {{ offering.instructor }}
                          </div>
                        {% endif %}

                        {% if offering.time %}
                          <div>
                            <strong>Time:</strong>
                            {{ offering.time }}
                          </div>
                        {% endif %}

                      </div>
                    {% endif %}

                    <div class="teaching-offering-content">
                      {{ offering.content }}
                    </div>

                  {% elsif offering.course_id %}

                    {% include course_schedule.liquid course_id=offering.course_id %}

                  {% else %}

                    {% if offering.description %}
                      {{ offering.description | markdownify }}
                    {% endif %}

                    <p>No additional course material available.</p>

                  {% endif %}

                </div>

                <div class="teaching-offering-footer">
                  <a href="{{ offering.url | relative_url }}">
                    Open full course page →
                  </a>
                </div>

              </div>
            </details>

          {% endfor %}
        </div>
      </section>

    {% endfor %}
  </div>

{% else %}
  <p>No courses available yet.</p>
{% endif %}