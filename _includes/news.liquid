<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign all_news = site.news | reverse %}

    {% if include.limit %}

      <div
        class="table-responsive"
        {% if page.announcements.scrollable and news_size > 3 %}
          style="max-height: 60vw"
        {% endif %}
      >
        <table class="table table-sm table-borderless">
          {% if page.announcements.limit %}
            {% assign news_limit = page.announcements.limit %}
          {% else %}
            {% assign news_limit = news_size %}
          {% endif %}
          {% for item in all_news limit: news_limit %}
            <tr>
              <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>
      <div class="text-right mt-2">
        <a href="{{ '/news/' | relative_url }}" class="news-all-link">all news &rarr;</a>
      </div>

    {% else %}

{% assign pub_news = all_news | where: "category", "publications" %}
{% assign award_news = all_news | where: "category", "awards" %}
{% assign talk_news = all_news | where: "category", "talks" %}

<div class="news-sections">
  <section class="news-box">
    <h2 class="news-box-title">📄 Publications</h2>

    <div class="news-box-scroll">
      {% if pub_news != blank %}
        <table class="table table-sm table-borderless news-table">
          <tbody>
            {% for item in pub_news %}
              <tr>
                <th scope="row">
                  {{ item.date | date: '%b %d, %Y' }}
                </th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">
                      {{ item.title }}
                    </a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="news-empty">No publications so far...</p>
      {% endif %}
    </div>
  </section>

  <section class="news-box">
    <h2 class="news-box-title">🏆 Awards</h2>

    <div class="news-box-scroll">
      {% if award_news != blank %}
        <table class="table table-sm table-borderless news-table">
          <tbody>
            {% for item in award_news %}
              <tr>
                <th scope="row">
                  {{ item.date | date: '%b %d, %Y' }}
                </th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">
                      {{ item.title }}
                    </a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="news-empty">No awards so far...</p>
      {% endif %}
    </div>
  </section>

  <section class="news-box">
    <h2 class="news-box-title">🎤 Talks and misc.</h2>

    <div class="news-box-scroll">
      {% if talk_news != blank %}
        <table class="table table-sm table-borderless news-table">
          <tbody>
            {% for item in talk_news %}
              <tr>
                <th scope="row">
                  {{ item.date | date: '%b %d, %Y' }}
                </th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">
                      {{ item.title }}
                    </a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="news-empty">No talks or misc. news so far...</p>
      {% endif %}
    </div>
  </section>
</div>

    {% endif %}

  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>